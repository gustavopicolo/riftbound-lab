# Copie para .env.local (desenvolvimento) ou cadastre na Vercel em Settings → Environment Variables.

# Chave da API da Anthropic (console.anthropic.com). Fica só no servidor.
ANTHROPIC_API_KEY=

# Opcional: modelo usado na análise e limite diário por usuário.
ANTHROPIC_MODEL=claude-sonnet-5-5
DAILY_ANALYSIS_LIMIT=30

# Supabase (Project Settings → API). A anon key é pública por design; a proteção vem das regras RLS do schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
